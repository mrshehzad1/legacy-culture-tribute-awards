# Apache config for Hostinger — Legacy Culture & Music Tribute Awards

# Default document (helps some Hostinger stacks resolve "/" cleanly)
DirectoryIndex index.html

# UTF-8 by default
AddDefaultCharset UTF-8

# ---- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ---- Browser caching -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML is built fresh; revalidate quickly
  ExpiresByType text/html "access plus 1 hour"
  # Long cache for static assets (filenames change only when rebuilt)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ---- Custom error page -----------------------------------------------------
ErrorDocument 404 /404.html

# ---- Block access to source/build files (not listed publicly) --------------
<FilesMatch "\.(py|md)$">
  Require all denied
</FilesMatch>
